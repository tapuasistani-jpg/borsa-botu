{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "functions": {
    "app/api/prices/route.ts": { "maxDuration": 10 },
    "app/api/analysis/route.ts": { "maxDuration": 10 },
    "app/api/news/route.ts": { "maxDuration": 10 },
    "app/api/backtest/route.ts": { "maxDuration": 10 },
    "app/api/telegram/send/route.ts": { "maxDuration": 10 }
  }
}
