# ============================================================
# BORSA BOTU — Ortam Degiskenleri
# Local: bu dosyayi .env.local olarak kopyala
# Vercel: Project Settings > Environment Variables (Production)
# ============================================================

# --- ZORUNLU (giris + guvenlik) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=GucluSifren123!
JWT_SECRET=super-gizli-anahtar-en-az-32-karakter-olmali-12345

# --- OPSIYONEL (Telegram sinyal botu) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CRON (cron-job.org — onerilen 5 dk, tum liste) ---
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- KALICI VERITABANI (Turso — Production ZORUNLU) ---
# https://turso.tech — database olustur, URL + token al
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Paper trading ---
PAPER_TRADING=true

# --- Telegram sinyal modu: all (AL/SAT/RISKLI) veya strong (sadece GUCULU) ---
TELEGRAM_SIGNAL_MODE=all

# --- Cron saglik ---
CRON_INTERVAL_MINUTES=5
CRON_STALE_MINUTES=15
